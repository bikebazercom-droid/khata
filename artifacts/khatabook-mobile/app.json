{
  "expo": {
    "name": "BanglaKhata",
    "slug": "khatabook-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "banglakhata",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.banglakhata.mobile",
      "buildNumber": "1",
      "supportsTablet": false
    },
    "android": {
      "package": "com.banglakhata.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#F7F9FC"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "BanglaKhata uses your photo library to attach bill images to ledger entries.",
          "cameraPermission": "BanglaKhata uses the camera to photograph bills for ledger entries."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F7F9FC"
        }
      ],
      "expo-sharing",
      "expo-audio",
      "expo-notifications",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7f93bc84-abe0-4e54-8831-507aba4ffbd1"
      }
    }
  }
}
